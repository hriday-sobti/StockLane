# Environment Variables Template for StockLane
# Copy this file to .env to configure local database credentials if using PostgreSQL.

# Database Backend Selection ("duckdb" or "postgres")
DB_BACKEND=duckdb

# DuckDB Local Storage
DUCKDB_PATH=data/stocklane.duckdb

# PostgreSQL Credentials (Only needed if DB_BACKEND=postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=stocklane
